{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "coverage/**",
    "benchmark/**",
    "**/lock.yaml",
    "**/package-lock.json"
  ]
}
