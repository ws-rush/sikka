{
  "name": "sikka",
  "version": "0.1.0",
  "description": "A zero-dependency Template engine.",
  "keywords": [
    "astro",
    "compiler",
    "engine",
    "html",
    "render",
    "sikka",
    "ssr",
    "template"
  ],
  "homepage": "https://github.com/ws-rush/sikka#readme",
  "bugs": {
    "url": "https://github.com/ws-rush/sikka/issues"
  },
  "license": "MIT",
  "author": "Rasheed Qaied <wusaby.rush@zohomail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ws-rush/sikka.git"
  },
  "files": [
    "dist/esm/cache.js",
    "dist/esm/compiler.js",
    "dist/esm/error.d.ts",
    "dist/esm/error.js",
    "dist/esm/escape.d.ts",
    "dist/esm/escape.js",
    "dist/esm/index.d.ts",
    "dist/esm/index.js",
    "dist/esm/parser.js",
    "dist/esm/precompile.d.ts",
    "dist/esm/precompile.js",
    "dist/esm/runtime.d.ts",
    "dist/esm/runtime.js",
    "dist/esm/types.d.ts",
    "dist/cjs/cache.js",
    "dist/cjs/compiler.js",
    "dist/cjs/error.d.ts",
    "dist/cjs/error.js",
    "dist/cjs/escape.d.ts",
    "dist/cjs/escape.js",
    "dist/cjs/index.d.ts",
    "dist/cjs/index.js",
    "dist/cjs/package.json",
    "dist/cjs/parser.js",
    "dist/cjs/precompile.d.ts",
    "dist/cjs/precompile.js",
    "dist/cjs/runtime.d.ts",
    "dist/cjs/runtime.js",
    "dist/cjs/types.d.ts",
    "README.md",
    "README.astro-syntax.md",
    "docs/SIKKA_1.0_CONTRACT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./precompile": {
      "import": {
        "types": "./dist/esm/precompile.d.ts",
        "default": "./dist/esm/precompile.js"
      },
      "require": {
        "types": "./dist/cjs/precompile.d.ts",
        "default": "./dist/cjs/precompile.js"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/esm/runtime.d.ts",
        "default": "./dist/esm/runtime.js"
      },
      "require": {
        "types": "./dist/cjs/runtime.d.ts",
        "default": "./dist/cjs/runtime.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "nub --test test/*.test.ts",
    "test:watch": "nub --test --watch test/*.test.ts",
    "test:coverage": "nub --test --experimental-test-coverage test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fallow": "fallow",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "node scripts/release.cjs",
    "bench": "node --expose-gc bench/index.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.2",
    "chalk": "^5.3.0",
    "conventional-changelog-cli": "^4.1.0",
    "enquirer": "^2.4.1",
    "execa": "^8.0.1",
    "fallow": "^3.10.0",
    "fast-check": "^4.7.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "semver": "^7.5.4",
    "typescript": "^7.0.2",
    "zod": "^4.3.6"
  },
  "packageManager": "nub@0.1.1"
}
